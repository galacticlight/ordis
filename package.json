{
  "name": "ordis",
  "version": "1.0.0",
  "private": true,
  "description": "Ordis — real-time desktop AI companion. Loyal ship cephalon for the Operator.",
  "author": "Prince Thai",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "vendor:voice": "node scripts/vendorVoiceExtras.cjs",
    "package": "electron-vite build && node scripts/vendorVoiceExtras.cjs && electron-builder --dir",
    "package:linux": "electron-vite build && node scripts/vendorVoiceExtras.cjs && electron-builder --linux dir",
    "package:darwin-arm64": "electron-vite build && node scripts/vendorVoiceExtras.cjs && electron-builder --mac dir --arm64",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.1",
    "kokoro-js": "^1.2.1",
    "three": "^0.170.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}

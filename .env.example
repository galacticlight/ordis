# Optional defaults for local development. The desktop Settings panel is the
# supported way to store keys (written to the OS user-data directory, never git).
# Never commit real secrets.

# Harbor (xAI) is the default. OpenAI-compatible chat completions also work.
ORDIS_API_BASE_URL=https://api.x.ai/v1

# Your provider key. Leave empty to stay unharbored: local precepts, memory, TTS.
ORDIS_API_KEY=

# Model id your endpoint expects
ORDIS_MODEL=grok-4.6

# Optional defaults for local development. The desktop Settings panel is the
# supported way to store keys (written to the OS user-data directory, never git).
# Never commit real secrets.

# OpenAI-compatible chat completions endpoint (no trailing slash required)
ORDIS_API_BASE_URL=https://api.openai.com/v1

# Your provider key. Leave empty to use offline Cephalon fallback lines.
ORDIS_API_KEY=

# Model id your endpoint expects
ORDIS_MODEL=gpt-4o-mini
